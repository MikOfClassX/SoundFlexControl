{
  "name": "soundflex-control",
  "version": "0.1.0",
  "private": true,
  "description": "ClassX SoundFlexControl desktop mixer controller for MixBoard",
  "author": "ClassX srl",
  "main": "desktop/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "start:desktop": "electron .",
    "build:installer": "npm run build && electron-builder --win nsis --x64",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node --test server/test/*.test.js",
    "test:ui": "vitest run",
    "test:layout": "node src/test/viewport-browser.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.2"
  }
}
